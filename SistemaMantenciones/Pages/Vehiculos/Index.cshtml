@page
@model SistemaMantenciones.Pages.Vehiculos.IndexModel
@{
    ViewData["Title"] = "Gestion de Vehiculos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestion de Flota de Vehiculos</h2>
        <a asp-page="./Crear" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle-fill me-1" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.5 4.5a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0 0 1h3v3a.5.5 0 0 0 1 0v-3h3a.5.5 0 0 0 0-1h-3v-3z"/>
            </svg>
            Agregar Nuevo Vehiculo
        </a>
    </div>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table table-striped table-bordered mt-3 text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Codigo</th>
                <th>Patente</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Tipo</th>
                <th>Kilometraje</th>
                <th>Estado</th>
                <th>Cambiar Estado</th>
                <th>Precio Diario</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.listaVehiculos != null && Model.listaVehiculos.Any())
            {
                foreach (var item in Model.listaVehiculos)
                {
                    string badgeColor = item.estado switch
                    {
                        "Activo" => "bg-success",
                        "Arrendado" => "bg-primary",
                        "En Mantenicion" => "bg-warning text-dark",
                        "De Baja" => "bg-danger",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td class="fw-bold">@item.codigo</td>
                        <td>@item.patente</td>
                        <td>@item.marca</td>
                        <td>@item.modelo</td>
                        <td>@item.tipo</td>
                        <td>@item.kilometraje.ToString("N0") km</td>
                        <td>
                            <span class="badge @badgeColor">@item.estado</span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="CambiaEstado" class="d-inline">
                                <input type="hidden" name="id" value="@item.codigo" />
                                <select name="nuevoEstado" onchange="this.form.submit()" class="form-select form-select-sm d-inline-block w-auto">
                                    <option value="Activo" selected="@(item.estado == "Activo" ? "selected" : null)">Activo</option>
                                    <option value="Arrendado" selected="@(item.estado == "Arrendado" ? "selected" : null)">Arrendado</option>
                                    <option value="En Mantenicion" selected="@(item.estado == "En Mantenicion" ? "selected" : null)">En Mantenicion</option>
                                    <option value="De Baja" selected="@(item.estado == "De Baja" ? "selected" : null)">De Baja</option>
                                </select>
                            </form>
                        </td>
                        <td class="fw-bold text-success">$@item.precioArriendoDiario.ToString("N0")</td>
                        <td>
                            <a asp-page="./Editar" asp-route-id="@item.codigo" class="btn btn-warning btn-sm">Editar</a>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="id" value="@item.codigo" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Esta seguro de que desea eliminar este vehiculo?');">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted p-4">
                        No hay vehiculos registrados en el sistema. ¡Agrega uno nuevo para comenzar!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
