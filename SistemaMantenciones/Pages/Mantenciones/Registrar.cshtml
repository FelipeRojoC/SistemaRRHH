@page
@model SistemaMantenciones.Pages.Mantenciones.RegistrarModel
@{
    ViewData["Title"] = "Registrar Mantenicion";
}

<div class="container mt-4">
    <h2>Registrar Mantenicion de Vehiculo</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Excelente!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <!-- Seleccion del Vehiculo -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Seleccionar Vehiculo</label>
                        <select asp-for="mantenicion.codigoVehiculo" asp-items="Model.listaVehiculos" class="form-select" required>
                            <option value="">-- Seleccione un Vehiculo --</option>
                        </select>
                        <span asp-validation-for="mantenicion.codigoVehiculo" class="text-danger small"></span>
                    </div>

                    <!-- Fecha de la Mantenicion -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Fecha de la Mantenicion</label>
                        <input asp-for="mantenicion.fecha" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="mantenicion.fecha" class="text-danger small"></span>
                    </div>

                    <!-- Horas de Trabajo -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Duracion de la Mantenicion (Horas)</label>
                        <input asp-for="mantenicion.horas" class="form-control" type="number" min="1" max="168" placeholder="Ej: 8" required />
                        <span asp-validation-for="mantenicion.horas" class="text-danger small"></span>
                    </div>

                    <!-- Descripcion del Trabajo -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Descripcion del Trabajo</label>
                        <input asp-for="mantenicion.descripcion" class="form-control" placeholder="Ej: Cambio de aceite y filtros" required />
                        <span asp-validation-for="mantenicion.descripcion" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">Registrar Mantenicion</button>
                    <a asp-page="/Index" class="btn btn-secondary px-4">Volver al Inicio</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
