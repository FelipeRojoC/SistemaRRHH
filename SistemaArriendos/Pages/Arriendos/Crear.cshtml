@page
@model SistemaArriendos.Pages.Arriendos.CrearModel
@{
    ViewData["Title"] = "Nuevo Arriendo";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Arriendo</h2>
    <p class="text-muted small">Solo se muestran vehiculos en estado <span class="badge bg-success">Activo</span>. Los precios se calculan automaticamente segun el valor diario del vehiculo y la cantidad de dias.</p>
    <hr />

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Vehiculo a Arrendar</label>
                        <select asp-for="arriendo.codigoVehiculo" asp-items="Model.listaVehiculosDisponibles" class="form-select" required>
                            <option value="">-- Seleccione un vehiculo disponible --</option>
                        </select>
                        <span asp-validation-for="arriendo.codigoVehiculo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Cliente</label>
                        <select asp-for="arriendo.rutCliente" asp-items="Model.listaClientes" class="form-select" required>
                            <option value="">-- Seleccione un cliente --</option>
                        </select>
                        <span asp-validation-for="arriendo.rutCliente" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Fecha de Inicio</label>
                        <input asp-for="arriendo.fechaInicio" class="form-control" type="date" required />
                        <span asp-validation-for="arriendo.fechaInicio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Fecha de Fin</label>
                        <input asp-for="arriendo.fechaFin" class="form-control" type="date" required />
                        <span asp-validation-for="arriendo.fechaFin" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-info mt-3 small mb-0">
                    <strong>Precio diario y total</strong> se cargaran automaticamente al guardar, usando el valor configurado del vehiculo y la cantidad de dias entre las fechas.
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">Registrar Arriendo</button>
                    <a asp-page="./Index" class="btn btn-secondary px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
