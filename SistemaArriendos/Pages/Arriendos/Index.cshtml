@page
@model SistemaArriendos.Pages.Arriendos.IndexModel
@{
    ViewData["Title"] = "Lista de Arriendos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Registro de Arriendos</h2>
        <a asp-page="./Crear" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle-fill me-1" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.5 4.5a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0 0 1h3v3a.5.5 0 0 0 1 0v-3h3a.5.5 0 0 0 0-1h-3v-3z"/>
            </svg>
            Nuevo Arriendo
        </a>
    </div>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <table class="table table-striped table-bordered mt-3 text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Vehiculo</th>
                <th>Cliente</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Precio Diario</th>
                <th>Total</th>
                <th>Estado Vehiculo</th>
                <th>Estado Arriendo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.listaArriendos != null && Model.listaArriendos.Any())
            {
                foreach (var item in Model.listaArriendos)
                {
                    bool tieneVehiculo = Model.mapaVehiculos.TryGetValue(item.codigoVehiculo, out var v);
                    string badgeColor = tieneVehiculo ? v!.estado switch
                    {
                        "Activo" => "bg-success",
                        "Arrendado" => "bg-primary",
                        "En Mantenicion" => "bg-warning text-dark",
                        "De Baja" => "bg-danger",
                        _ => "bg-secondary"
                    } : "bg-secondary";

                    string estadoVehiculo = tieneVehiculo ? v!.estado : "Desconocido";

                    <tr>
                        <td class="fw-bold">@item.id</td>
                        <td>
                            <strong>@item.codigoVehiculo</strong><br />
                            @if (tieneVehiculo)
                            {
                                <small class="text-muted">@v!.marca @v.modelo (@v.patente)</small>
                            }
                        </td>
                        <td>
                            <strong>@item.rutClienteNavigation.nombre</strong><br />
                            <small class="text-muted">@item.rutCliente</small>
                        </td>
                        <td>@item.fechaInicio.ToString("dd-MM-yyyy")</td>
                        <td>@item.fechaFin.ToString("dd-MM-yyyy")</td>
                        <td>$@item.precioDiario.ToString("N0")</td>
                        <td class="fw-bold text-success">$@item.precioTotal.ToString("N0")</td>
                        <td><span class="badge @badgeColor">@estadoVehiculo</span></td>
                        <td>
                            @if (item.estado == "Activo")
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cerrado</span>
                            }
                        </td>
                        <td>
                            @if (item.estado == "Activo" && estadoVehiculo == "Arrendado")
                            {
                                <form method="post" asp-page-handler="CerrarArriendo" class="d-inline">
                                    <input type="hidden" name="id" value="@item.id" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Confirmar cierre del arriendo? El vehiculo volvera a estado Activo.');">Cerrar Arriendo</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted p-4">
                        Aun no se han registrado arriendos. ¡Crea el primero!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
